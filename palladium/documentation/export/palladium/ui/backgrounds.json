[{"namespace":"palladium","path":"empty","name":"Empty","description":"Empty background. Renders nothing","fields":[]},{"namespace":"palladium","path":"texture","name":"Texture","description":"Renders a static texture as a background.","fields":[{"key":"texture","type":{"type":"combined","options":["Texture Reference","Dynamic Texture"]},"description":"Texture path.","required":true,"fallback":null},{"key":"width","type":"Integer (>= 0)","description":"Width of the texture file.","required":false,"fallback":256},{"key":"height","type":"Integer (>= 0)","description":"Height of the texture file.","required":false,"fallback":256}]},{"namespace":"palladium","path":"repeating_texture","name":"Repeating Texture","description":"Repeating a texture so often that it fills the background.","fields":[{"key":"texture","type":{"type":"combined","options":["Texture Reference","Dynamic Texture"]},"description":"Texture path.","required":true,"fallback":null},{"key":"width","type":"Integer (>= 0)","description":"Width of the texture file.","required":false,"fallback":256},{"key":"height","type":"Integer (>= 0)","description":"Height of the texture file.","required":false,"fallback":256}]},{"namespace":"palladium","path":"random_tiles","name":"Random Tiles","description":"Fills the background with a random mix of tiles, like a floor of different blocks. It starts with the base texture everywhere, then every layer scatters patches of its own texture over it, in the order they are listed. The pattern is always the same for the same seed.","fields":[{"key":"base","type":{"type":"combined","options":["Texture Reference","Dynamic Texture"]},"description":"The texture that fills every tile at first. Either a texture, or an object with 'texture' and 'random_rotation'.","required":true,"fallback":null},{"key":"layers","type":{"type":"array","items":{"type":"object","name":"Layer","fields":[{"key":"texture","type":{"type":"combined","options":["Texture Reference","Dynamic Texture"]},"description":"The texture used for this layer.","required":true,"fallback":null},{"key":"random_rotation","type":"Boolean","description":"Whether to rotate the texture randomly.","required":false,"fallback":false},{"key":"chance","type":{"type":"number","minimum":0.0,"maximum":1.0},"description":"The chance for each tile to start a patch.","required":true,"fallback":null},{"key":"size","type":{"type":"combined","options":["Integer (> 0)",{"type":"object","name":"Object"}]},"description":"How many tiles a patch covers, as a positive integer or an integer provider. Use 1 for single tiles.","required":false,"fallback":1}]}},"description":"Textures scattered over the base tile, in list order.","required":false,"fallback":[]},{"key":"tile_size","type":"Integer (> 0)","description":"The size of a tile in pixels.","required":false,"fallback":16},{"key":"seed","type":"Integer","description":"The seed of the random pattern.","required":false,"fallback":0}],"examples":[{"type":"palladium:random_tiles","base":{"texture":"minecraft:textures/block/dirt.png","random_rotation":true},"layers":[{"texture":"minecraft:textures/block/coarse_dirt.png","random_rotation":true,"chance":0.03,"size":{"min_inclusive":3,"max_inclusive":8,"type":"minecraft:uniform"}},{"texture":"minecraft:textures/block/gravel.png","chance":0.02}]}]},{"namespace":"palladium","path":"sprite","name":"Sprite","description":"Renders a sprite accordingly to fill the background.","fields":[{"key":"sprite","type":"Identifier","description":"Sprite ID.","required":true,"fallback":null}]}]