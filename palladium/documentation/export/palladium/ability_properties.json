[{"namespace":"palladium","path":"ability_properties","name":"Ability Properties","description":"Common settings inside an ability's \"properties\" object.","fields":[{"key":"title","type":"Text Component / Value","description":"The display title for the ability.","required":false,"fallback":null},{"key":"icon","type":"Icon definition","description":"The ability's icon. Defaults to a barrier item icon.","required":false,"fallback":null},{"key":"description","type":{"type":"combined","options":["Text Component / Value",{"type":"object","name":"Locked and Unlocked Descriptions","fields":[{"key":"locked","type":"Text Component / Value","description":"The description shown while the ability is locked.","required":true,"fallback":null},{"key":"unlocked","type":"Text Component / Value","description":"The description shown while the ability is unlocked.","required":true,"fallback":null}]}]},"description":"A shared description or separate descriptions for the locked and unlocked states.","required":false,"fallback":null},{"key":"color","type":{"type":"enum","values":["white","orange","magenta","light_blue","yellow","lime","pink","gray","light_gray","cyan","purple","blue","brown","green","red","black"]},"description":"The display color for the ability.","required":false,"fallback":"gray"},{"key":"hidden_in_gui","type":"Boolean","description":"Hide the ability from the power's GUI.","required":false,"fallback":false},{"key":"hidden_in_bar","type":"Boolean","description":"Hide the ability from the ability bar.","required":false,"fallback":false},{"key":"list_index","type":{"type":"combined","options":["Integer / Value","MoLang"]},"description":"The ability's position in the ability list. Use -1 for the default ordering.","required":false,"fallback":-1},{"key":"animation_timer","type":{"type":"combined","options":["Integer",{"type":"object","name":"Animation Timer","fields":[{"key":"min","type":{"type":"combined","options":["Integer","Time String (\"40s\", \"2m\", etc.)"]},"des